# Wingate — copy to `.env.local` (never commit that file)

# --- Required to launch on Supabase + Vercel ---
# Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Project Settings → Database → URI (session pooler, port 5432, sslmode=require)
DATABASE_URL=postgresql://postgres.YOUR-REF:PASSWORD@HOST.pooler.supabase.com:5432/postgres?sslmode=require
# Direct (non-pooler) URI for python3 scripts/apply-supabase.py
DATABASE_URL_UNPOOLED=postgresql://postgres.YOUR-REF:PASSWORD@HOST.db.supabase.co:5432/postgres?sslmode=require

# Live site URL after Vercel (use http://127.0.0.1:43191 locally)
WINGATE_TAX_APP_URL=http://127.0.0.1:43191

# Required in production: at least 32 random characters. Never use the placeholder below.
WINGATE_TAX_SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Optional. Empty = test payment in tax onboarding and practice checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Local only. Unsigned Stripe webhooks are refused in production.
# STRIPE_ALLOW_UNSIGNED_WEBHOOK=1

# Local only. Production never returns verification or reset codes in API JSON.
# WINGATE_MAIL_PREVIEW=1

# Do not retry HMRC sandbox OAuth (invalid_client). MTD bridging is in development.
# HMRC_CLIENT_ID=
# HMRC_CLIENT_SECRET=
