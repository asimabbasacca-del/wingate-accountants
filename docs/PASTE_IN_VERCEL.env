# Paste into Vercel → Project → Settings → Environment Variables
# Apply to Production AND Preview. Root Directory = wingate

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres.YOUR-REF:YOUR-PASSWORD@HOST.pooler.supabase.com:5432/postgres?sslmode=require
WINGATE_TAX_APP_URL=https://www.wingateaccountants.co.uk
WINGATE_TAX_SESSION_SECRET=

# Optional (live card checkout). Leave empty for test-card onboarding.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Do NOT set in production:
# WINGATE_MAIL_PREVIEW=1
# STRIPE_ALLOW_UNSIGNED_WEBHOOK=1
